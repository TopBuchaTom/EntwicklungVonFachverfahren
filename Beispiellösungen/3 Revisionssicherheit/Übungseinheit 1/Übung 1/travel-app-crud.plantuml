@startuml travelsapp.datamodel.crud
skinparam classAttributeIconSize 0
hide circle

namespace travelsapp.datamodel.crud {
    class User <<Entity>> {
        +id: int {readonly} {autoincrement}
        +name: String
        +password: String
        +email: String {unique}
        +email_verified_at: DateTime
        +remember_token: String
        +is_admin: Boolean
        +is_verifier: Boolean
        +is_approver: Boolean
    }

    class Travel <<Entity>> {
        +id: int {readonly} {autoincrement}
        +title: String
        +location: String
        +start: DateTime
        +end: DateTime
        +amount: decimal
        +details: String
    }
    Travel "*" -left> "1" User: applicant
    Travel "*" o-- "*" User: participants
    Travel "1" *-- "1..*" Review: reviews

    note top of Travel
        Simple CRUD approach:
        Only latest update of a travel is persisted
    end note

    class Review <<Entity>> {
        +id: int {readonly} {autoincrement}
        +travel_id: int
        +user_id: int
        +type: ReviewType
        +state: ReviewState
        +changed: Boolean
        +comment: String
    }
    Review -> User: user

    enum ReviewType <<Enumeration>> extends String {
        Request
        Verification
        Approval
    }

    enum ReviewState <<Enumeration>> extends String {
        Pending
        Accepted
        Declined
    }
}

@enduml
