@startuml travelsapp.datamodel.revisions.states
skinparam classAttributeIconSize 0
hide circle

namespace travelsapp.datamodel.revisions.states {
    class Travel <<Entity>> {
         +id: int {readonly} {autoincrement}
        +title: String
        +location: String
        +start: DateTime
        +end: DateTime
        +amount: decimal
        +details: String
    }

    Travel "*" -> "1" User: applicant
    Travel "*" o-- "*" User: participants
    (Travel, User) ..Participant
    Travel "1" *-- "1..*" Review: reviews

    Travel <|-- RequestedTravel
    Travel <|-- VerificatedTravel
    Travel <|-- ApprovedTravel

    note top of Travel
        Simple revisions approach:
        One extra entity for each type (e.g. travel) and association (e.g. participant) to track or same entity with additional attribute
        Requires a lot of memory because for each state all data is copied, even if no changes were made
    end note

    class Participant {
        +id: int {readonly} {autoincrement}
        +travel_id: int
        +user_id: int
    }

    Participant <|-- RequestedParticipant
    Participant <|-- VerificatedParticipant
    Participant <|-- ApprovedParticipant

    class User <<Entity>> {
        +id: int {readonly} {autoincrement}
        +name: String
        +password: String
        +email: String {unique}
        +email_verified_at: DateTime
        +remember_token: String
        +is_admin: Boolean
        +is_verifier: Boolean
        +is_approver: Boolean
    }

    class Review <<Entity>> {
        +id: int {readonly} {autoincrement}
        +travel_id: int
        +user_id: int
        +type: ReviewType
        +state: ReviewState
        +changed: Boolean
        +comment: String
    }
    Review -> User: user

    enum ReviewType <<Enumeration>> extends String {
        Request
        Verification
        Approval
    }

    enum ReviewState <<Enumeration>> extends String {
        Pending
        Accepted
        Declined
    }
}

@enduml
