@startuml travelsapp.datamodel.crud
skinparam classAttributeIconSize 0
hide circle

namespace travelsapp.datamodel.crud {
    class User <<Entity>> {
        +id: int {readonly} {autoincrement}
        +name: String
        +password: String
        +email: String {unique}
        +email_verified_at: DateTime
        +remember_token: String
        +is_admin: Boolean
        +is_verifier: Boolean
        +is_approver: Boolean
    }

    class Travel <<Entity>> {
        +id: int {readonly} {autoincrement}
        +title: String
        +location: String
        +start: DateTime
        +end: DateTime
        +amount: decimal
        +details: String
    }
    Travel "*" -left> "1" User: applicant
    Travel "*" o-- "*" User: participants
    Travel "1" *-- "1..*" Review: reviews

    note top of Travel
        Advantaged revisions approach:
        Only one additional Event entity is needed
        Only changes are persisted instead of full data copies
    end note

    class Review <<Entity>> {
        +id: int {readonly} {autoincrement}
        +travel_id: int
        +user_id: int
        +type: ReviewType
        +state: ReviewState
        +changed: Boolean
        +comment: String
    }
    Review -> User: user

    enum ReviewType <<Enumeration>> extends String {
        Request
        Verification
        Approval
    }

    enum ReviewState <<Enumeration>> extends String {
        Pending
        Accepted
        Declined
    }

    class Event <<Entity>> {
        +id: int {readonly} {autoincrement}
        +entity: string {entity_name}
        +record_id: int {entity_row_id}
        +parent_id: int {parent_entity_row_id}
        +action_id: int {entity_review_id}
        +action_type: ActionType,
        +data: String
    }

    enum ActionType <<Enumeration>> extends String {
        None
        Added
        Updated
        Deleted
    }

    note top of Event
        Saves only changes, e.g.
        - entity=Travel, record_id=travelId1, action_id=reviewId1, action_type=ADDED, ...
        - entity=Participant, record_id=userId1, parentId=travelId1, action_id=reviewId1, action_type=ADDED, ...
        - entity=Participant, record_id=userId2, parentId=travelId1, action_id=reviewId1, action_type=ADDED, ...
        - entity=Participant, record_id=userId2, parentId=travelId1, action_id=reviewId2, action_type=DELETED, ...
        ...
        - entity=Travel, record_id=travelId1, action_id=reviewId6, action_type=UPDATED, ...
        - entity=Participant, record_id=userId4, parentId=travelId1, action_id=reviewId6, action_type=UPDATED, ...

    end note

    note bottom of Event
        Current state of entity and related entities is calculated based on algorithm:
        - ENTITIES = Get original state of entity and related entities, e.g. initial travel entry with initial participants
        - For each ENTITY of ENTITIES
          - For each EVENT of EVENTS(ENTITY.ID)
            - ENTITY = Apply EVENT (added, updated, deleted) TO ENTITY
    end note
}

@enduml
